{
  "name": "urly",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Copy open tab URLs and open pasted links in one click.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "assets:icons": "node scripts/export-icons.mjs",
    "postinstall": "wxt prepare",
    "assets:store": "wxt build && node scripts/store-assets.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.9.1"
}
